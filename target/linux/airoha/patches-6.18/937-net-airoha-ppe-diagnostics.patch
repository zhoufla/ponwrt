+/* "<src ip|0> <dst ip|0> <tcp|udp|proto num|0> <count>" */
+static ssize_t airoha_ppe_debugfs_trace_write(struct file *file,
+					      const char __user *user_buf,
+					      size_t count, loff_t *ppos)
+{
+	struct seq_file *m = file->private_data;
+	struct airoha_ppe *ppe = m->private;
+	char buf[96], a[20], b[20], pr[20];
+	u32 num, proto = 0;
+	__be32 saddr = 0, daddr = 0;
+	int ret;
+
+	ret = airoha_ppe_debugfs_copy(buf, sizeof(buf), user_buf, count);
+	if (ret)
+		return ret;
+
+	if (sscanf(buf, "%19s %19s %19s %u", a, b, pr, &num) != 4)
+		return -EINVAL;
+
+	if (strcmp(a, "0") &&
+	    !in4_pton(a, -1, (u8 *)&saddr, '\0', NULL))
+		return -EINVAL;
+	if (strcmp(b, "0") &&
+	    !in4_pton(b, -1, (u8 *)&daddr, '\0', NULL))
+		return -EINVAL;
+	if (!strcmp(pr, "tcp")) {
+		proto = IPPROTO_TCP;
+	} else if (!strcmp(pr, "udp")) {
+		proto = IPPROTO_UDP;
+	} else if (strcmp(pr, "0") && sscanf(pr, "%u", &proto) != 1) {
+		return -EINVAL;
+	}
+
+	WRITE_ONCE(ppe->trace_left, 0);
+	ppe->trace_saddr = saddr;
+	ppe->trace_daddr = daddr;
+	ppe->trace_proto = proto;
+	WRITE_ONCE(ppe->trace_idx, 0);
+	WRITE_ONCE(ppe->trace_left, num);
+
+	return count;
+}
+AIROHA_PPE_DEBUGFS_RW(airoha_ppe_debugfs_trace, airoha_ppe_debugfs_trace_show,
+		      airoha_ppe_debugfs_trace_write);
