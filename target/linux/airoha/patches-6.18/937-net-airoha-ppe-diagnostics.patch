+int airoha_ppe_diag_npu_init(struct airoha_ppe *ppe,
+			     const struct airoha_npu_hwnat_args *args,
+			     bool deinit);
+int airoha_ppe_diag_npu_fw(struct airoha_ppe *ppe, const char *rv32_name,
