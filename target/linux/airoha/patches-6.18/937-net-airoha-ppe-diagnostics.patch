+static int airoha_ppe_debugfs_diag_show(struct seq_file *m, void *private)
+{
+	airoha_ppe_diag_show(m);
+
+	return 0;
+}
+
+static ssize_t airoha_ppe_debugfs_diag_write(struct file *file,
+					     const char __user *user_buf,
+					     size_t count, loff_t *ppos)
+{
+	struct seq_file *m = file->private_data;
+	struct airoha_ppe *ppe = m->private;
+	char buf[32];
+	u32 en;
+	int ret;
+
+	ret = airoha_ppe_debugfs_copy(buf, sizeof(buf), user_buf, count);
+	if (ret)
+		return ret;
+
+	if (!strcmp(buf, "reset\n")) {
+		airoha_ppe_diag_reset();
+	} else if (sscanf(buf, "%u", &en) == 1) {
+		WRITE_ONCE(ppe->diag_en, en ? 1 : 0);
+	} else {
+		return -EINVAL;
+	}
+
+	return count;
+}
+AIROHA_PPE_DEBUGFS_RW(airoha_ppe_debugfs_diag, airoha_ppe_debugfs_diag_show,
+		      airoha_ppe_debugfs_diag_write);
