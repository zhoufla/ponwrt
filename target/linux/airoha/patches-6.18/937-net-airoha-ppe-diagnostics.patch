+
+static ssize_t airoha_ppe_debugfs_reg_write(struct file *file,
+					    const char __user *user_buf,
+					    size_t count, loff_t *ppos)
+{
+	struct seq_file *m = file->private_data;
+	struct airoha_ppe *ppe = m->private;
+	char buf[96];
+	u32 off, mask = 0, val = 0;
+	int ret;
+
+	ret = airoha_ppe_debugfs_copy(buf, sizeof(buf), user_buf, count);
+	if (ret)
+		return ret;
+
+	ret = sscanf(buf, "%x %x %x", &off, &mask, &val);
+	if (ret != 1 && ret != 3)
+		return -EINVAL;
+
+	WRITE_ONCE(ppe->reg_off, off);
+	if (ret == 3) {
+		ret = airoha_ppe_diag_reg_write(ppe, off, mask, val);
+		if (ret)
+			return ret;
+	}
+
+	return count;
+}
+AIROHA_PPE_DEBUGFS_RW(airoha_ppe_debugfs_reg, airoha_ppe_debugfs_reg_show,
+		      airoha_ppe_debugfs_reg_write);
