+
+/* "<wan_mode> <ppe_type> <wan_sel> <max_packet> <cds> <xpon_hal_api>
+ *  <wan_xsi> <ct_joyme4>" re-runs the NPU HWNAT init (missing values keep
+ * the driver defaults), "deinit" runs the NPU HWNAT deinit.
+ */
+static ssize_t airoha_ppe_debugfs_npu_init_write(struct file *file,
+						 const char __user *user_buf,
+						 size_t count, loff_t *ppos)
+{
+	struct seq_file *m = file->private_data;
+	struct airoha_ppe *ppe = m->private;
+	struct airoha_npu_hwnat_args args = {};
+	char buf[128];
+	/* driver defaults, see airoha_npu_ppe_init() */
+	u32 v[8] = { QDMA_WAN_ETHER, PPE_TYPE_L2B_IPV4_IPV6, };
+	bool deinit;
+	int ret, n;
+
+	ret = airoha_ppe_debugfs_copy(buf, sizeof(buf), user_buf, count);
+	if (ret)
+		return ret;
+
+	deinit = !strcmp(buf, "deinit\n");
+	if (!deinit) {
+		n = sscanf(buf, "%u %u %u %u %u %u %u %u", &v[0], &v[1],
+			   &v[2], &v[3], &v[4], &v[5], &v[6], &v[7]);
+		if (n < 1)
+			return -EINVAL;
+
+		args.wan_mode = v[0];
+		args.ppe_type = v[1];
+		args.wan_sel = v[2];
+		args.max_packet = v[3];
+		args.cds = v[4];
+		args.xpon_hal_api = v[5];
+		args.wan_xsi = v[6];
+		args.ct_joyme4 = v[7];
+	}
+
+	ret = airoha_ppe_diag_npu_init(ppe, &args, deinit);
+	if (ret)
+		return ret;
+
+	return count;
+}
+AIROHA_PPE_DEBUGFS_RW(airoha_ppe_debugfs_npu_init, airoha_ppe_debugfs_regdump_show,
+		      airoha_ppe_debugfs_npu_init_write);
+
+/* "<rv32 image> <data image>": images below /lib/firmware/ */
+static ssize_t airoha_ppe_debugfs_npu_fw_write(struct file *file,
+					       const char __user *user_buf,
+					       size_t count, loff_t *ppos)
+{
+	struct seq_file *m = file->private_data;
+	struct airoha_ppe *ppe = m->private;
+	char buf[192], rv32[96], data[96];
+	int ret;
+
+	ret = airoha_ppe_debugfs_copy(buf, sizeof(buf), user_buf, count);
+	if (ret)
+		return ret;
+
+	if (sscanf(buf, "%95s %95s", rv32, data) != 2)
+		return -EINVAL;
+
+	ret = airoha_ppe_diag_npu_fw(ppe, rv32, data);
+	if (ret)
+		return ret;
+
+	return count;
+}
+AIROHA_PPE_DEBUGFS_RW(airoha_ppe_debugfs_npu_fw, airoha_ppe_debugfs_regdump_show,
+		      airoha_ppe_debugfs_npu_fw_write);
+
 
