+/* "<offset>" selects the register shown on read,
+ * "<offset> <mask> <value>" additionally modifies it. Values are hex.
+ */
+static int airoha_ppe_debugfs_reg_show(struct seq_file *m, void *private)
+{
+	struct airoha_ppe *ppe = m->private;
+	u32 off = READ_ONCE(ppe->reg_off);
+
+	seq_printf(m, "%04x: %08x\n", off, airoha_fe_rr(ppe->eth, off));
