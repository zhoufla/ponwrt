 }
 
+static int airoha_npu_ppe_init(struct airoha_npu *npu)
+{
+	struct airoha_npu_hwnat_args args = {
+		.ppe_type = PPE_TYPE_L2B_IPV4_IPV6,
+		.wan_mode = QDMA_WAN_ETHER,
+	};
+
+	return airoha_npu_ppe_hwnat_init(npu, &args);
+}
+
+static int airoha_npu_wlan_msg_get(struct airoha_npu *npu, int ifindex,
+				   enum airoha_npu_wlan_get_cmd func_id,
+				   void *data, int data_len, gfp_t gfp);
+
+/* Replace the running NPU firmware with images looked up in the firmware
+ * search path and reboot the NPU cores. The PPE must be initialized again
+ * afterwards.
+ */
+static int airoha_npu_fw_reload(struct airoha_npu *npu, const char *rv32_name,
+				const char *data_name)
+{
+	struct resource *reg, mem;
+	void __iomem *sram, *code;
+	u32 val;
+	int ret, i;
+
+	ret = of_reserved_mem_region_to_resource(npu->dev->of_node, 0, &mem);
+	if (ret)
+		return ret;
+
+	reg = platform_get_resource(to_platform_device(npu->dev),
+				   IORESOURCE_MEM, 0);
+	if (!reg)
+		return -EINVAL;
+
+	code = ioremap(mem.start, resource_size(&mem));
+	if (!code)
+		return -ENOMEM;
+
+	sram = ioremap(reg->start, resource_size(reg));
+	if (!sram) {
+		ret = -ENOMEM;
+		goto out;
+	}
+
+	ret = airoha_npu_load_firmware(npu->dev, code, rv32_name,
+				       NPU_EN7581_FIRMWARE_RV32_MAX_SIZE);
+	if (ret)
+		goto out_sram;
+
+	ret = airoha_npu_load_firmware(npu->dev, sram + REG_NPU_LOCAL_SRAM,
+				       data_name,
+				       NPU_EN7581_FIRMWARE_DATA_MAX_SIZE);
+out_sram:
+	iounmap(sram);
+	if (ret)
+		goto out;
+
+	/* enable NPU cores, see airoha_npu_probe() */
+	regmap_write(npu->regmap, REG_CR_NPU_MIB(10),
+		     mem.start + NPU_EN7581_FIRMWARE_RV32_MAX_SIZE);
+	regmap_write(npu->regmap, REG_CR_NPU_MIB(11), 0x40000); /* SRAM 256K */
+	regmap_write(npu->regmap, REG_CR_NPU_MIB(12), 0);
+	regmap_write(npu->regmap, REG_CR_NPU_MIB(21), 1);
+	msleep(100);
+
+	for (i = 0; i < NPU_NUM_CORES; i++)
+		regmap_write(npu->regmap, REG_CR_BOOT_BASE(i), mem.start);
+	usleep_range(1000, 2000);
+
+	regmap_write(npu->regmap, REG_CR_BOOT_CONFIG, 0xff);
+	regmap_write(npu->regmap, REG_CR_BOOT_TRIGGER, 0x1);
+	msleep(100);
+
+	ret = airoha_npu_wlan_msg_get(npu, 0, WLAN_FUNC_GET_WAIT_NPU_VERSION,
+				      &val, sizeof(val), GFP_KERNEL);
+	if (ret) {
+		dev_err(npu->dev, "NPU did not answer after firmware reload\n");
+		goto out;
+	}
+
+	dev_info(npu->dev, "NPU fw reloaded (%s + %s): version %d.%d\n",
+		 rv32_name, data_name, (val >> 16) & 0xffff, val & 0xffff);
+	ret = 0;
+
+out:
+	iounmap(code);
+
+	return ret;
+}
+
 static int airoha_npu_ppe_deinit(struct airoha_npu *npu)
 {
 	struct ppe_mbox_data *ppe_data;
@@ -743,6 +836,8 @@
 	npu->dev = dev;
 	npu->ops.ppe_init = airoha_npu_ppe_init;
 	npu->ops.ppe_deinit = airoha_npu_ppe_deinit;
+	npu->ops.ppe_hwnat_init = airoha_npu_ppe_hwnat_init;
+	npu->ops.fw_reload = airoha_npu_fw_reload;
 	npu->ops.ppe_init_stats = airoha_npu_ppe_stats_setup;
 	npu->ops.ppe_flush_sram_entries = airoha_npu_ppe_flush_sram_entries;
 	npu->ops.ppe_foe_commit_entry = airoha_npu_foe_commit_entry;
diff -ruN T_base/drivers/net/ethernet/airoha/airoha_ppe.c T_new/drivers/net/ethernet/airoha/airoha_ppe.c
--- a/drivers/net/ethernet/airoha/airoha_ppe.c
+++ b/drivers/net/ethernet/airoha/airoha_ppe.c
@@ -11,6 +11,7 @@
 #include <linux/ip.h>
 #include <linux/ipv6.h>
 #include <linux/of_platform.h>
+#include <linux/percpu.h>
 #include <linux/platform_device.h>
 #include <linux/rhashtable.h>
 #include <net/ipv6.h>
@@ -1666,6 +1667,477 @@
 	return err;
 }
 
+/* --- diagnostics ------------------------------------------------------- */
+
+#define AIROHA_DIAG_NO_HASH              4
+#define AIROHA_DIAG_SKIPPED              5
+
+struct airoha_rx_diag {
+	u64 pkts[AIROHA_DIAG_NUM_KEYS][AIROHA_DIAG_NUM_REASONS];
+	u64 bytes[AIROHA_DIAG_NUM_KEYS][AIROHA_DIAG_NUM_REASONS];
+	u64 states[AIROHA_DIAG_NUM_KEYS][AIROHA_DIAG_NUM_REASONS]
+		[AIROHA_DIAG_NUM_STATES];
+	u32 seq;
+};
+
+static DEFINE_PER_CPU(struct airoha_rx_diag, airoha_rx_diag);
+
+/* Reason names follow mtk_ppe.h (same PPE IP). */
+static const char *const airoha_diag_reason_str[AIROHA_DIAG_NUM_REASONS] = {
+	[0x00] = "none",
+	[0x01] = "0x01",
+	[0x02] = "TTL_EXCEEDED",
+	[0x03] = "OPTION_HEADER",
+	[0x04] = "0x04",
+	[0x05] = "0x05",
+	[0x06] = "0x06",
+	[0x07] = "NO_FLOW",
+	[0x08] = "IPV4_FRAG",
+	[0x09] = "IPV4_DSLITE_FRAG",
+	[0x0a] = "IPV4_DSLITE_NO_TCP_UDP",
+	[0x0b] = "IPV6_6RD_NO_TCP_UDP",
+	[0x0c] = "TCP_FIN_SYN_RST",
+	[0x0d] = "UN_HIT",
+	[0x0e] = "HIT_UNBIND",
+	[0x0f] = "HIT_UNBIND_RATE_REACHED",
+	[0x10] = "HIT_BIND_TCP_FIN",
+	[0x11] = "HIT_TTL_1",
+	[0x12] = "HIT_BIND_VLAN_VIOLATION",
+	[0x13] = "KEEPALIVE_UC_OLD_HDR",
+	[0x14] = "KEEPALIVE_MC_NEW_HDR",
+	[0x15] = "KEEPALIVE_DUP_OLD_HDR",
+	[0x16] = "HIT_BIND_FORCE_CPU",
+	[0x17] = "TUNNEL_OPTION_HEADER",
+	[0x18] = "MULTICAST_TO_CPU",
+	[0x19] = "MULTICAST_TO_GMAC1_CPU",
+	[0x1a] = "HIT_PRE_BIND",
+	[0x1b] = "PACKET_SAMPLING",
+	[0x1c] = "EXCEED_MTU",
+	[0x1d] = "0x1d",
+	[0x1e] = "PPE_BYPASS",
+	[0x1f] = "INVALID",
+};
+
+static int airoha_ppe_diag_key(struct airoha_gdm_dev *dev)
+{
+	return ((dev->port->id & 3) << 1) |
+		!!test_bit(AIROHA_DEV_F_PON, &dev->flags);
+}
+
+/* State of the FOE entry at hash as the hardware sees it. DRAM entries are
+ * the table itself, SRAM entries need an indirect register read.
+ */
+static int airoha_ppe_diag_entry_state(struct airoha_ppe *ppe, u32 hash)
+{
+	u32 sram_num_entries = airoha_ppe_get_total_sram_num_entries(ppe);
+	struct airoha_foe_entry *hwe;
+	struct airoha_eth *eth = ppe->eth;
+	u32 val;
+	bool ppe2;
+
+	if (hash >= airoha_ppe_get_total_num_entries(ppe))
+		return -EINVAL;
+
+	hwe = ppe->foe + hash * sizeof(*hwe);
+	if (hash >= sram_num_entries)
+		return FIELD_GET(AIROHA_FOE_IB1_BIND_STATE,
+				 READ_ONCE(hwe->ib1));
+
+	ppe2 = hash >= PPE_SRAM_NUM_ENTRIES;
+
+	spin_lock_bh(&ppe_lock);
+	airoha_fe_wr(eth, REG_PPE_RAM_CTRL(ppe2),
+		     FIELD_PREP(PPE_SRAM_CTRL_ENTRY_MASK, hash) |
+		     PPE_SRAM_CTRL_REQ_MASK);
+	if (read_poll_timeout_atomic(airoha_fe_rr, val,
+				     val & PPE_SRAM_CTRL_ACK_MASK,
+				     10, 100, false, eth,
+				     REG_PPE_RAM_CTRL(ppe2))) {
+		spin_unlock_bh(&ppe_lock);
+		return -ETIMEDOUT;
+	}
+	val = airoha_fe_rr(eth, REG_PPE_RAM_ENTRY(ppe2, 0));
+	spin_unlock_bh(&ppe_lock);
+
+	return FIELD_GET(AIROHA_FOE_IB1_BIND_STATE, val);
+}
+
+static u32 airoha_ppe_diag_ib2(const struct airoha_foe_entry *hwe)
+{
+	int type = FIELD_GET(AIROHA_FOE_IB1_BIND_PACKET_TYPE, hwe->ib1);
+
+	if (type == PPE_PKT_TYPE_BRIDGE)
+		return hwe->bridge.ib2;
+	if (type >= PPE_PKT_TYPE_IPV6_ROUTE_3T)
+		return hwe->ipv6.ib2;
+
+	return hwe->ipv4.ib2;
+}
+
+/* Locate the IPv4 header of a frame handed to the RX path. eth_type_trans()
+ * has run, but the network header is not set yet, and PON frames still carry
+ * their 802.1Q tag and PPPoE session header.
+ */
+static const struct iphdr *airoha_ppe_diag_ipv4_hdr(const struct sk_buff *skb)
+{
+	int off = 0, len = skb_headlen(skb) - sizeof(struct iphdr);
+	u16 type = ntohs(skb->protocol);
+
+	while (len - off >= 0) {
+		if (type == ETH_P_IP)
+			return (const struct iphdr *)(skb->data + off);
+
+		if ((type == ETH_P_8021Q || type == ETH_P_8021AD) &&
+		    len - off >= VLAN_HLEN) {
+			type = get_unaligned_be16(skb->data + off + VLAN_HLEN - 2);
+			off += VLAN_HLEN;
+		} else if (type == ETH_P_PPP_SES && len - off >= 8) {
+			type = get_unaligned_be16(skb->data + off + 6);
+			off += 8;	/* session header + PPP protocol */
+			if (type == 0x0021)	/* PPP_IP */
+				type = ETH_P_IP;
+		} else {
+			break;
+		}
+	}
+
+	return NULL;
+}
+
+static void airoha_ppe_diag_trace(struct airoha_ppe *ppe, struct sk_buff *skb,
+				  int key, u32 hash, u32 reason, u32 msg0,
+				  u32 msg1)
+{
+	struct airoha_diag_rec *r;
+	struct airoha_foe_entry *hwe;
+	const struct iphdr *ih = NULL;
+	u8 *l4;
+	int state = AIROHA_DIAG_NO_HASH;
+	u8 *data;
+	u32 left, idx, head, i;
+
+	ih = airoha_ppe_diag_ipv4_hdr(skb);
+
+	if ((ppe->trace_saddr &&
+	     ppe->trace_saddr != (ih ? ih->saddr : 0)) ||
+	    (ppe->trace_daddr &&
+	     ppe->trace_daddr != (ih ? ih->daddr : 0)) ||
+	    (ppe->trace_proto &&
+	     ppe->trace_proto != (ih ? ih->protocol : 0)))
+		return;
+
+	left = READ_ONCE(ppe->trace_left);
+	if (!left)
+		return;
+	WRITE_ONCE(ppe->trace_left, left - 1);
+
+	idx = READ_ONCE(ppe->trace_idx) % AIROHA_DIAG_TRACE_SZ;
+	WRITE_ONCE(ppe->trace_idx, idx + 1);
+	r = &ppe->trace[idx];
+
+	memset(r, 0, sizeof(*r));
+	r->ms = jiffies_to_msecs(jiffies);
+	r->hash = hash;
+	r->reason = reason;
+	r->key = key;
+	r->len = skb->len;
+	r->msg0 = msg0;
+	r->msg1 = msg1;
+
+	if (ih) {
+		r->saddr = ih->saddr;
+		r->daddr = ih->daddr;
+		r->proto = ih->protocol;
+		l4 = (u8 *)ih + ih->ihl * 4;
+		if ((ih->protocol == IPPROTO_TCP ||
+		     ih->protocol == IPPROTO_UDP) &&
+		    l4 + 4 <= skb->data + skb_headlen(skb)) {
+			u32 ports;
+
+			ports = get_unaligned_be32(l4);
+			r->sport = ports >> 16;
+			r->dport = ports & 0xffff;
+		}
+	}
+
+	if (hash < airoha_ppe_get_total_num_entries(ppe)) {
+		hwe = airoha_ppe_foe_get_entry(ppe, hash);
+		if (hwe) {
+			r->ib1 = hwe->ib1;
+			r->ib2 = airoha_ppe_diag_ib2(hwe);
+			state = FIELD_GET(AIROHA_FOE_IB1_BIND_STATE,
+					  hwe->ib1);
+		}
+	}
+	r->state = state;
+
+	/* eth_type_trans() already pulled the ethernet header */
+	data = skb->data - ETH_HLEN;
+	head = min_t(u32, AIROHA_DIAG_TRACE_HEAD,
+		     skb_headlen(skb) + ETH_HLEN);
+	for (i = 0; i < head; i++)
+		r->head[i] = data[i];
+}
+
+void airoha_ppe_diag_rx(struct airoha_ppe *ppe, struct airoha_gdm_dev *dev,
+			struct sk_buff *skb, u32 msg0, u32 msg1)
+{
+	struct airoha_rx_diag *d = this_cpu_ptr(&airoha_rx_diag);
+	u32 hash = FIELD_GET(AIROHA_RXD4_FOE_ENTRY, msg1);
+	u32 reason = FIELD_GET(AIROHA_RXD4_PPE_CPU_REASON, msg1);
+	int key = airoha_ppe_diag_key(dev);
+	int state = AIROHA_DIAG_NO_HASH;
+
+	if (!READ_ONCE(ppe->diag_en))
+		return;
+
+	d->pkts[key][reason]++;
+	d->bytes[key][reason] += skb->len;
+
+	if (hash != AIROHA_RXD4_FOE_ENTRY) {
+		state = AIROHA_DIAG_SKIPPED;
+		/* SRAM lookups cost a register round trip: keep one in four */
+		if (hash >= airoha_ppe_get_total_sram_num_entries(ppe) ||
+		    !(d->seq++ & 3)) {
+			state = airoha_ppe_diag_entry_state(ppe, hash);
+			if (state < 0)
+				state = AIROHA_DIAG_NO_HASH;
+		}
+	}
+	d->states[key][reason][state]++;
+
+	if (READ_ONCE(ppe->trace_left))
+		airoha_ppe_diag_trace(ppe, skb, key, hash, reason, msg0,
+				      msg1);
+}
+
+void airoha_ppe_diag_reset(void)
+{
+	struct airoha_rx_diag *d;
+	int cpu;
+
+	for_each_possible_cpu(cpu) {
+		d = per_cpu_ptr(&airoha_rx_diag, cpu);
+		memset(d, 0, sizeof(*d));
+	}
+}
+
+void airoha_ppe_diag_show(struct seq_file *m)
+{
+	static const char *const state_str[AIROHA_DIAG_NUM_STATES] = {
+		"INV", "UNB", "BND", "FIN", "nohash", "skip",
+	};
+	u64 pkts[AIROHA_DIAG_NUM_REASONS];
+	u64 bytes[AIROHA_DIAG_NUM_REASONS];
+	u64 states[AIROHA_DIAG_NUM_REASONS][AIROHA_DIAG_NUM_STATES];
+	struct airoha_ppe *ppe = m->private;
+	struct airoha_rx_diag *d;
+	int cpu, key, reason, state;
+
+	seq_printf(m, "en=%u trace_left=%u\n", READ_ONCE(ppe->diag_en),
+		   READ_ONCE(ppe->trace_left));
+
+	for (key = 0; key < AIROHA_DIAG_NUM_KEYS; key++) {
+		u64 total = 0;
+
+		memset(pkts, 0, sizeof(pkts));
+		memset(bytes, 0, sizeof(bytes));
+		memset(states, 0, sizeof(states));
+		for_each_possible_cpu(cpu) {
+			d = per_cpu_ptr(&airoha_rx_diag, cpu);
+			for (reason = 0; reason < AIROHA_DIAG_NUM_REASONS;
+			     reason++) {
+				pkts[reason] += d->pkts[key][reason];
+				bytes[reason] += d->bytes[key][reason];
+				for (state = 0; state < AIROHA_DIAG_NUM_STATES;
+				     state++)
+					states[reason][state] +=
+						d->states[key][reason][state];
+			}
+		}
+
+		for (reason = 0; reason < AIROHA_DIAG_NUM_REASONS; reason++)
+			total += pkts[reason];
+		if (!total)
+			continue;
+
+		seq_printf(m, "key %d-%s pkts=%llu\n", key >> 1,
+			   key & 1 ? "pon" : "lan", total);
+		for (reason = 0; reason < AIROHA_DIAG_NUM_REASONS; reason++) {
+			if (!pkts[reason])
+				continue;
+
+			seq_printf(m, "  r%02x %-26s pkts=%-9llu bytes=%-11llu",
+				   reason, airoha_diag_reason_str[reason],
+				   pkts[reason], bytes[reason]);
+			for (state = 0; state < AIROHA_DIAG_NUM_STATES;
+			     state++)
+				seq_printf(m, " %s=%llu", state_str[state],
+					   states[reason][state]);
+			seq_putc(m, '\n');
+		}
+	}
+}
+
+void airoha_ppe_diag_trace_show(struct seq_file *m)
+{
+	struct airoha_ppe *ppe = m->private;
+	struct airoha_diag_rec *r;
+	u32 n, i;
+
+	if (!ppe->trace)
+		return;
+
+	n = min_t(u32, READ_ONCE(ppe->trace_idx), AIROHA_DIAG_TRACE_SZ);
+	for (i = 0; i < n; i++) {
+		r = &ppe->trace[i];
+
+		seq_printf(m, "%u %d-%s hash=%04x r%02x st%u %pI4:%u>%pI4:%u "
+			   "pr=%u len=%u ib1=%08x ib2=%08x msg0=%08x "
+			   "msg1=%08x head=%40ph\n",
+			   r->ms, r->key >> 1, r->key & 1 ? "pon" : "lan",
+			   r->hash, r->reason, r->state,
+			   &r->saddr, r->sport, &r->daddr, r->dport,
+			   r->proto, r->len, r->ib1, r->ib2, r->msg0,
+			   r->msg1, r->head);
+	}
+}
