+int airoha_ppe_diag_reg_write(struct airoha_ppe *ppe, u32 off, u32 mask,
+			      u32 val)
+{
+	if (off >= 0x8000 || (off & 3))
+		return -EINVAL;
+
+	airoha_fe_rmw(ppe->eth, off, mask, val);
+
+	return 0;
+}
+
+int airoha_ppe_diag_npu_init(struct airoha_ppe *ppe,
+			     const struct airoha_npu_hwnat_args *args,
+			     bool deinit)
+{
+	struct airoha_eth *eth = ppe->eth;
+	struct airoha_npu *npu;
+	int err;
+
+	mutex_lock(&flow_offload_mutex);
+
+	npu = rcu_dereference_protected(eth->npu,
+					lockdep_is_held(&flow_offload_mutex));
+	if (!npu) {
+		err = -ENODEV;
+		goto unlock;
+	}
+
+	err = deinit ? npu->ops.ppe_deinit(npu)
+		     : npu->ops.ppe_hwnat_init(npu, args);
+	if (err || deinit)
+		goto unlock;
+
+	err = airoha_ppe_wait_for_npu_init(eth);
+	if (err)
+		goto unlock;
+
+	airoha_ppe_hw_init(ppe);
+unlock:
+	mutex_unlock(&flow_offload_mutex);
+
+	return err;
+}
+
+int airoha_ppe_diag_npu_fw(struct airoha_ppe *ppe, const char *rv32_name,
+			   const char *data_name)
+{
+	struct airoha_npu *npu;
+	int err;
+
+	mutex_lock(&flow_offload_mutex);
+
+	npu = rcu_dereference_protected(ppe->eth->npu,
+					lockdep_is_held(&flow_offload_mutex));
+	if (!npu || !npu->ops.fw_reload) {
+		err = -ENODEV;
+		goto unlock;
+	}
+
+	err = npu->ops.fw_reload(npu, rv32_name, data_name);
+unlock:
+	mutex_unlock(&flow_offload_mutex);
+
+	return err;
+}
+
+int airoha_ppe_diag_foe_read(struct airoha_ppe *ppe, u32 hash, u32 *words)
+{
+	struct airoha_foe_entry *hwe;
+
+	if (hash >= airoha_ppe_get_total_num_entries(ppe))
+		return -EINVAL;
+
+	hwe = airoha_ppe_foe_get_entry(ppe, hash);
+	if (!hwe)
+		return -ETIMEDOUT;
+
+	memcpy(words, hwe->data, sizeof(hwe->data));
+
+	return 0;
+}
+
+int airoha_ppe_diag_foe_write(struct airoha_ppe *ppe, u32 hash, u32 word,
+			      u32 mask, u32 val)
+{
+	u32 sram_num_entries = airoha_ppe_get_total_sram_num_entries(ppe);
+	struct airoha_flow_table_entry *e;
+	struct rhashtable_iter iter;
+	struct airoha_foe_entry *hwe;
+	u32 *w;
+	int err = 0;
+
+	if (hash >= airoha_ppe_get_total_num_entries(ppe) ||
+	    word >= sizeof(struct airoha_foe_entry) / sizeof(u32))
+		return -EINVAL;
+
+	mutex_lock(&flow_offload_mutex);
+
+	/* keep the software copy in sync, or the next stats run detects a
+	 * mismatch and the flow is bound again from scratch
+	 */
+	rhashtable_walk_enter(&ppe->eth->flow_table, &iter);
+	rhashtable_walk_start(&iter);
+	while ((e = rhashtable_walk_next(&iter))) {
+		if (IS_ERR(e))
+			continue;
+		if (e->type != FLOW_TYPE_L4 || e->hash != hash)
+			continue;
+
+		w = (u32 *)&e->data;
+		w[word] = (w[word] & ~mask) | (val & mask);
+	}
+	rhashtable_walk_stop(&iter);
+	rhashtable_walk_exit(&iter);
+
+	spin_lock_bh(&ppe_lock);
+	hwe = airoha_ppe_foe_get_entry_locked(ppe, hash);
+	if (!hwe) {
+		err = -ETIMEDOUT;
+		goto unlock;
+	}
+
+	w = (u32 *)hwe;
+	w[word] = (w[word] & ~mask) | (val & mask);
+
+	if (hash < sram_num_entries)
+		err = airoha_ppe_foe_commit_sram_entry(ppe, hash);
+unlock:
+	spin_unlock_bh(&ppe_lock);
+
+	mutex_unlock(&flow_offload_mutex);
+
+	return err;
+}
