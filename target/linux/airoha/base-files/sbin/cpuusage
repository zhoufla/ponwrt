#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
# Copyright (C) 2026 zhoufla
#
# CPU usage + Airoha PPE offload status for the LuCI overview page
# ("CPU usage (%)" row). Wired into luci's getCPUUsage RPC by
# etc/uci-defaults/992_set-ppe-load.sh, same pattern as qualcommax/qualcommbe.

set -- $(top -bn1 | awk '/^CPU:/ {print $2, $4; exit}')
usr=$1
sys=$2

# Hardware onload ratio for the PON uplink.
#
# pon0 tx_packets is the GDM counter of frames actually handed to the PON MAC,
# including the ones the PPE forwards by itself. tx_packets_submitted counts
# only the frames the CPU queue submitted. The difference is the share the
# PPE forwarded without the CPU, which is the number worth showing.
#
# Do NOT derive this from ppe/diag: that histogram only sees the packets that
# were delivered to the CPU in the first place, so its BND share (typically
# 1-3%) measures exception traffic, not offload. And do not walk ppe/bind or
# ppe/entries either: both take bottom halves down once per entry (~1.1s on a
# 13k-entry table) and stall softirqs while the PPE is busy.
DATAPATH="/sys/kernel/debug/airoha-xpon-pon0/datapath"
TX_FILE="/sys/class/net/pon0/statistics/tx_packets"

if [ -r "$DATAPATH" ] && [ -r "$TX_FILE" ]; then
	tx=$(cat "$TX_FILE" 2>/dev/null)
	sub=$(awk '/^tx_packets_submitted:/{print $2; exit}' "$DATAPATH" 2>/dev/null)
	case "$tx$sub" in
	''|*[!0-9]*) ;;
	*) [ "$tx" -gt 0 ] && ratio=$(( (tx - sub) * 100 / tx )) ;;
	esac
fi

# FOE table occupancy, from the counter the driver caches for 30s (939).
# This is the headroom left for the bind_rate=4 setting: the table filling up
# is what makes the offload ratio collapse, so it belongs next to it.
USAGE_FILE="/sys/kernel/debug/ppe/usage"

if [ -r "$USAGE_FILE" ]; then
	usage=$(cat "$USAGE_FILE" 2>/dev/null)
	foe_used=${usage#*used=}; foe_used=${foe_used%% *}
	foe_total=${usage#*total=}
	case "$foe_used$foe_total" in
	''|*[!0-9]*) ;;
	*) [ "$foe_total" -gt 0 ] && \
		foe=" FOE: ${foe_used}/${foe_total}" ;;
	esac
fi

if [ -n "$ratio" ]; then
	echo -n "USR: ${usr:-N/A} SYS: ${sys:-N/A} PPE: ${ratio}% hw${foe}"
else
	echo -n "USR: ${usr:-N/A} SYS: ${sys:-N/A}${foe}"
fi
