/*
 * LuCI rpcd ucode plugin: expose the Airoha PPE offload debugfs "config"
 * node to the LuCI status page. The node is provided by the PonWrt patch
 * target/linux/airoha/patches-6.18/925-net-airoha-add-PON-PPE-offload-metadata.patch:
 *
 *   npu_attached: <0|1>
 *   gdm2_fwd_cfg / fe_wan_port / fe_vip_port_en / fe_ifc_port_en: %08x
 *   ppeN_flow_cfg: %08x
 *   ppeN_table_cfg: %08x
 *   ppeN_gdm2_default_cpu_port: <u32>
 */

'use strict';

import { readfile } from 'fs';

const CONFIG_PATH = '/sys/kernel/debug/ppe/config';

/* Per-PPE fields; value 1 marks numeric (non-hexadecimal) fields. */
const PPE_FIELDS = {
	flow_cfg: 0,
	table_cfg: 0,
	gdm2_default_cpu_port: 1
};

function parse_config() {
	const data = readfile(CONFIG_PATH);

	if (data == null)
		return null;

	const status = { ppe: [] };

	for (let line in split(data, '\n')) {
		const m = match(line, /^([^:]+):[ \t]*(\S+)\s*$/);

		if (!m)
			continue;

		const key = m[1];
		const val = m[2];
		const pm = match(key, /^ppe([0-9]+)_(.+)$/);

		if (key == 'npu_attached') {
			status.npu_attached = +val;
		}
		else if (pm && pm[2] in PPE_FIELDS) {
			const idx = +pm[1];

			while (length(status.ppe) <= idx)
				push(status.ppe, { index: length(status.ppe) });

			status.ppe[idx][pm[2]] = PPE_FIELDS[pm[2]] ? +val : val;
		}
		else {
			status[key] = val;
		}
	}

	return status;
}

const methods = {
	getStatus: {
		call: function(request) {
			const status = parse_config();

			if (status == null)
				return { error: 'PPE debugfs config node not available' };

			return status;
		}
	}
};

return { 'airoha-npu': methods };
